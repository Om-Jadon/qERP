{
  "manifest_version": 3,
  "name": "qERP",
  "version": "1.8.1",
  "description": "Unofficial one-click login helper for the IIT Kharagpur ERP. Not affiliated with IIT Kharagpur. Data stays on your device.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://erp.iitkgp.ac.in/*"
  ],
  "action": {
    "default_title": "qERP: one-click ERP login",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.iitkgp.ac.in/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://mail.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}